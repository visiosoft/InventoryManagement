# Copy to .env (gitignored) and fill in per environment.

# Base URL the client calls for the API. Local dev points at the local server;
# each deployed site (Netlify) sets its own.
VITE_API_BASE_URL=http://localhost:5010/api

# Which deployment this is. main and SAASModel are deployed as two separate
# sites — this is what tells them apart in the UI (sidebar badge) since
# nothing else visibly differs. Set to "demo" or "production" per site's own
# Netlify env vars; anything else (including unset) shows as Production.
VITE_APP_ENV=production

# Used by the WhatsApp setup page to call the WhatsApp integration service.
VITE_WHATSAPP_LEAD_URL=https://whatsapp.purplebox.ae
VITE_WHATSAPP_LEAD_API_KEY=
