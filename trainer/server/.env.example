# AI Training Center API — created automatically on the server by server/deploy.sh.
PORT=5020
# Its own database (may share a MongoDB cluster, never a database, with anything else).
TRAINER_MONGODB_URI=mongodb+srv://user:pass@cluster/...
TRAINER_DB_NAME=ai_trainer
# 32+ random characters. Encrypts stored AI keys and tokens and signs sessions —
# changing it signs everyone out and makes stored keys unreadable.
TRAINER_SECRET=
# Browser origins allowed to call the API directly (the website normally goes through its own /api proxy).
TRAINER_WEB_ORIGINS=https://train.purplebox.ae
# Optional fallback platform AI keys (the platform admin can also set them in the app).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
