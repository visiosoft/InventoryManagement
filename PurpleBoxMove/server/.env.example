# --- Server ---
PORT=4000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/purplebox
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/purplebox?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/purplebox

# Secret used to sign JWTs — change this to a long random string.
JWT_SECRET=change-me-to-a-long-random-secret

# Public base URL the app uses to load uploaded media.
# In dev this is your machine's address as seen by the phone:
#   - Android emulator: http://10.0.2.2:4000
#   - iOS simulator:    http://localhost:4000
#   - Real device:      http://<your-computer-LAN-IP>:4000  (e.g. http://192.168.1.20:4000)
PUBLIC_URL=http://localhost:4000

# Demo mode: when true, the OTP code is returned in the API response and
# any 4-digit code is accepted (no real SMS provider needed).
DEMO_OTP=true

# Optional seed admin (used by `npm run seed:admin`)
ADMIN_PHONE=500000000
ADMIN_PASSWORD=purplebox

# --- Google Drive (for media uploads) ---
# Path to your Google Cloud service account JSON key file.
# Default: looks for google-service-account.json in the server/ directory.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./google-service-account.json

# Optional: ID of a Google Drive folder where lead folders will be created.
# If omitted, folders are created in the service account's root drive.
GOOGLE_DRIVE_FOLDER_ID=
